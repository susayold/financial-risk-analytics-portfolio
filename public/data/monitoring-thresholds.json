{
  "version": "E0-1.0.1",
  "metrics": {
    "PSI": {
      "frequency_scope": "annual|quarterly|monthly",
      "green": "x < 0.10",
      "amber": "0.10 <= x < 0.25",
      "red": "x >= 0.25",
      "insufficient_sample": "eligible n>=1000 where applicable",
      "persistence": "same metric+frequency+population"
    },
    "MISSINGNESS_SHIFT_PP": {
      "frequency_scope": "annual|quarterly|monthly",
      "green": "x < 2",
      "amber": "2 <= x <= 5",
      "red": "x > 5",
      "insufficient_sample": "eligible source-field coverage",
      "persistence": "same metric+frequency+population"
    },
    "COVERAGE_DROP_PP": {
      "frequency_scope": "annual|quarterly|monthly",
      "green": "x < 2",
      "amber": "2 <= x <= 5",
      "red": "x > 5",
      "insufficient_sample": "eligible source-field coverage",
      "persistence": "same metric+frequency+population"
    },
    "AUC_DROP": {
      "frequency_scope": "annual|quarterly|monthly",
      "green": "x <= 0.02",
      "amber": "0.02 < x <= 0.05",
      "red": "x > 0.05",
      "insufficient_sample": "n>=1000,bad>=100,good>=100",
      "persistence": "same metric+frequency+population"
    },
    "KS_DROP": {
      "frequency_scope": "annual|quarterly|monthly",
      "green": "x <= 0.03",
      "amber": "0.03 < x <= 0.07",
