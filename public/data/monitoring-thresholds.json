      "amber": "0.02 <= x <= 0.05",
      "red": "x > 0.05",
      "insufficient_sample": "n>=2000,bad>=150",
      "persistence": "same metric+frequency+population"
    },
    "CALIBRATION_SLOPE": {
      "frequency_scope": "annual|quarterly|monthly",
      "green": "0.75 <= x <= 1.25",
